generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id                String   @id @default(uuid())
  studentId         String   @unique
  fullName          String
  major             String   // CNTT, KTPM, TTNT, KHAC
  phone             String?  // Không bắt buộc (đã bỏ khỏi form)
  gameType          String   @default("SUDOKU") // SUDOKU hoặc CODE_SPRINT
  durationInSeconds Int
  isCorrect         Boolean  @default(false)
  isGiftClaimed     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([gameType, isCorrect, durationInSeconds])
}
